# Variables for docker-compose.yaml to provide ...
# ... variables to only use inside docker-compose.yaml
# ... build arguments (ARG)
# ... environment variables (ENV)

###################################################################################
###--- Variables to use in docker-compose.yaml ---------------------------------###
###################################################################################
DOCKER_TAG=latest
DOCKER_REGISTRY=gitlab.lrz.de:5005/teleoperiertes_fahren/tod

###################################################################################
###--- ARGs at build time ------------------------------------------------------###
###################################################################################
# Base Stage build arguments are shared over all following stages. All other build
# arguments are stage-specific.
# Build arguments which are also set as enviroment variable during build process 
# are marked with #ENV.

###--- Base Stage (Shared over all stages)
DOCKER_UID=1000
DOCKER_USERNAME=tum
DOCKER_ROS_DISTRO=humble

###--- Builder Stage
VEHICLE_BUILD_ARGS="--cmake-args -DVEHICLE=ON -DOPERATOR=OFF -DCMAKE_BUILD_TYPE=Release"
OPERATOR_BUILD_ARGS="--cmake-args -DVEHICLE=OFF -DOPERATOR=ON -DCMAKE_BUILD_TYPE=Release"

###################################################################################
###--- ENV and arguments at container start-up ---------------------------------###
###################################################################################
# These variables are set as environment variables at container start-up and can be
# changed without rebuilding the images.

###--- ROS Settings
DOCKER_ROS_DOMAIN_ID=7
DOCKER_RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

###--- Middleware Configuration
# no_multicast: For usage on personal machines.
# unconfigured: (WARNING: Multicasting into all network interfaces is enabled.)
DOCKER_CYCLONEDDS_CONFIG=unconfigured

###--- ROS Launch Arguments
# vehicle: Vehicle software is started on an actual vehicle
# only_sim: vehicle software is started in simulation mode
MODE=only_sim  # options are vehicle, only_sim

# edgar: start software for the EDGAR research vehicle
# rc-car: start software for the RC-Car research vehicle
# edgarautoware: start software with Autoware interaction
VEHICLE_ID=edgar