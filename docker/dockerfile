# syntax=docker/dockerfile:1.7

###################################################################################
###--- tod_base --Base----------------------------------------------------------###
###################################################################################
ARG DOCKER_ROS_DISTRO=humble

FROM ros:${DOCKER_ROS_DISTRO}-ros-base AS tod_base

ARG DOCKER_USERNAME
ARG DOCKER_UID
ARG DOCKER_GID

###--- Create an non-root dev user ---------------------------------------------###
RUN groupadd --gid ${DOCKER_GID} ${DOCKER_USERNAME} \
    && useradd -s /bin/bash --uid ${DOCKER_UID} --gid ${DOCKER_GID} -m ${DOCKER_USERNAME} \
    && echo ${DOCKER_USERNAME} ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/${DOCKER_USERNAME}\
    && chmod 0440 /etc/sudoers.d/${DOCKER_USERNAME} \
    && mkdir -p /home/${DOCKER_USERNAME} \
    && mkdir -p /run/user/${DOCKER_UID} \
    && chown -R ${DOCKER_UID}:${DOCKER_GID} /home/${DOCKER_USERNAME} \
    && chown -R ${DOCKER_UID}:${DOCKER_GID} /run/user/${DOCKER_UID} \
    && chmod -R 700 /run/user/${DOCKER_UID} \
    && rm -rf /var/lib/apt-get/lists/*
ENV DOCKER_USERNAME=${DOCKER_USERNAME}

###--- Use a nearby Ubuntu mirror for more reliable package downloads -----------###
RUN sed -i \
    -e 's#http://archive.ubuntu.com/ubuntu#http://mirrors.tuna.tsinghua.edu.cn/ubuntu#g' \
    -e 's#http://security.ubuntu.com/ubuntu#http://mirrors.tuna.tsinghua.edu.cn/ubuntu#g' \
    /etc/apt/sources.list

###--- Remove old GPG key and update ---###
RUN set -eux; \
    rm -f /etc/apt/sources.list.d/ros2*.list \
          /etc/apt/sources.list.d/ros2*.sources \
          /usr/share/keyrings/ros-archive-keyring.gpg; \
    apt-get update && \
    apt-get install -y --no-install-recommends curl gnupg2 ca-certificates; \
    curl --retry 5 --retry-delay 2 -fsSL https://mirrors.tuna.tsinghua.edu.cn/rosdistro/ros.key \
      | gpg --dearmor -o /usr/share/keyrings/ros-archive-keyring.gpg; \
    echo "deb [arch=$(dpkg --print-architecture) \
        signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
        http://mirrors.tuna.tsinghua.edu.cn/ros2/ubuntu \
        $(. /etc/os-release && echo $VERSION_CODENAME) main" \
      > /etc/apt/sources.list.d/ros2.list

###--- Install basic apt packages -----------------------------------------------###
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    pkg-config \
    python3-dev \
    git \
    software-properties-common

###--- Install ROS packages -----------------------------------------------------###
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-rmw-cyclonedds-cpp

###--- Improve network resilience for apt and rosdep ----------------------------###
RUN printf '%s\n' \
    'Acquire::Retries "5";' \
    'Acquire::http::Timeout "60";' \
    'Acquire::https::Timeout "60";' \
    > /etc/apt/apt.conf.d/80network-retries \
    && sed -i \
        's#https://raw.githubusercontent.com/ros/rosdistro/master#https://mirrors.tuna.tsinghua.edu.cn/rosdistro#g' \
        /etc/ros/rosdep/sources.list.d/20-default.list
ENV ROSDISTRO_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/rosdistro/index-v4.yaml

###--- Install GSTREAMER packages -----------------------------------------------###
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgstreamer1.0-0 \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    gstreamer1.0-tools \
    gstreamer1.0-x \
    gstreamer1.0-alsa \
    gstreamer1.0-gl \
    gstreamer1.0-gtk3 \
    gstreamer1.0-qt5 \
    gstreamer1.0-pulseaudio \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    libgstrtspserver-1.0-dev

###--- Install network monitoring utilities ------------------------------------###
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpcap-dev \
    iperf3 \
    iputils-ping

###--- Set default shell -------------------------------------------------------###
SHELL ["/bin/bash", "-c"]

###--- Setup ROS workspace -----------------------------------------------------###
WORKDIR /home/${DOCKER_USERNAME}/wsp

###--- Setup entrypoint --------------------------------------------------------###
RUN chown -R ${DOCKER_UID}:${DOCKER_GID} /home/${DOCKER_USERNAME}/wsp
COPY ./docker/entrypoint.sh /
COPY ./docker/colcon_retry.sh /usr/local/bin/colcon_retry
COPY ./docker/rosdep_retry.sh /usr/local/bin/rosdep_retry
RUN chmod +x /entrypoint.sh /usr/local/bin/colcon_retry /usr/local/bin/rosdep_retry
ENTRYPOINT [ "/entrypoint.sh" ]


###################################################################################
###--- tod_vehicle_base --Base-Extension----------------------------------------###
###################################################################################
FROM tod_base AS tod_vehicle_base

RUN apt-get update

###--- Login with user ---------------------------------------------------------###
USER ${DOCKER_USERNAME}

###--- Install dependencies via rosdep -----------------------------------------###
RUN --mount=type=bind,source=src,target=/home/${DOCKER_USERNAME}/wsp/src \
    rosdep_retry ${ROS_DISTRO}

###--- Source entrypoint -------------------------------------------------------###
RUN echo "source /entrypoint.sh" >> /home/${DOCKER_USERNAME}/.bashrc


###################################################################################
###--- tod_operator_base --Base-Extension---------------------------------------###
###################################################################################
FROM tod_base AS tod_operator_base

###--- Install QT packages -----------------------------------------------------###
RUN apt-get update && apt-get install -y --no-install-recommends \
    qtbase5-dev \
    qt5-qmake \
    qtbase5-dev-tools \
    qt5-doc \
    qml-module-qtquick2 \
    qtpositioning5-dev \
    qtlocation5-dev \
    libqt5svg5-dev

###--- Install GLM, GLFW, GLEW and other packages ------------------------------###
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglfw3-dev \
    libglew-dev \
    libglm-dev \
    libassimp-dev \
    libfreetype-dev \
    zenity \
    dbus-x11 \
    fonts-liberation

###--- Install OPENCV ------------------------------###
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-opencv \
    libopencv-dev \
    ros-${ROS_DISTRO}-cv-bridge 

###--- Install OpenVR ----------------------------------------------------------###
RUN add-apt-repository multiverse -y
RUN cd /tmp && \
    curl --retry 5 --retry-all-errors --retry-delay 2 -fL \
        https://codeload.github.com/ValveSoftware/openvr/tar.gz/refs/tags/v1.14.15 \
        -o openvr-v1.14.15.tar.gz && \
    tar -xzf openvr-v1.14.15.tar.gz && \
    cd openvr-1.14.15 && \
    mkdir build && \
    cd build && \
    cmake .. && \
    make -j"$(nproc)" && \
    sudo make install && \
    sudo ldconfig && \
    cd /tmp && \
    rm -rf openvr-1.14.15 openvr-v1.14.15.tar.gz

RUN apt-get update

###--- Login with user ---------------------------------------------------------###
USER ${DOCKER_USERNAME}

###--- Install dependencies via rosdep -----------------------------------------###
WORKDIR /home/${DOCKER_USERNAME}/wsp
RUN --mount=type=bind,source=src,target=/home/${DOCKER_USERNAME}/wsp/src \
    rosdep_retry ${ROS_DISTRO}

###--- Source entrypoint -------------------------------------------------------###
RUN echo "source /entrypoint.sh" >> /home/${DOCKER_USERNAME}/.bashrc

###################################################################################
###--- tod_vehicle_builder --Builder--------------------------------------------###
###################################################################################
FROM tod_vehicle_base AS tod_vehicle_builder

ARG VEHICLE_BUILD_ARGS

###--- Build colcon workspace --------------------------------------------------###
WORKDIR /home/${DOCKER_USERNAME}/wsp
RUN --mount=type=bind,source=src,target=/home/${DOCKER_USERNAME}/wsp/src \
    --mount=type=bind,source=config,target=/home/${DOCKER_USERNAME}/wsp/config \
    source /opt/ros/${ROS_DISTRO}/setup.bash \
    && colcon_retry vehicle ${VEHICLE_BUILD_ARGS}

# The safety gate is required by every vehicle launch profile. Build and verify
# it explicitly so an incomplete generic workspace install fails at image build.
# Root is required here because BuildKit owns context mounts and may preserve a
# restrictive source-directory mode that hides the package from the build user.
USER root
RUN --mount=type=bind,source=src,target=/home/${DOCKER_USERNAME}/wsp/src \
    source /opt/ros/${ROS_DISTRO}/setup.bash \
    && source install/setup.bash \
    && colcon_retry vehicle-safety --packages-select tod_safety_gate ${VEHICLE_BUILD_ARGS} \
    && test -x install/tod_safety_gate/lib/tod_safety_gate/safety_gate
USER ${DOCKER_USERNAME}


###################################################################################
###--- tod_operator_builder --Builder-------------------------------------------###
###################################################################################
FROM tod_operator_base AS tod_operator_builder

ARG OPERATOR_BUILD_ARGS

###--- Build colcon workspace --------------------------------------------------###
WORKDIR /home/${DOCKER_USERNAME}/wsp
RUN --mount=type=bind,source=src,target=/home/${DOCKER_USERNAME}/wsp/src \
    --mount=type=bind,source=config,target=/home/${DOCKER_USERNAME}/wsp/config \
    source /opt/ros/${ROS_DISTRO}/setup.bash \
    && colcon_retry operator ${OPERATOR_BUILD_ARGS}


###################################################################################
###--- tod_dev --Development----------------------------------------------------###
###################################################################################
FROM tod_operator_base AS tod_dev

USER root

###--- Install additional apt packages for development -------------------------###
RUN apt-get update && apt-get install -y --no-install-recommends \
    gdb \
    gdbserver \
    nano \
    ros-${ROS_DISTRO}-rqt \
    ros-${ROS_DISTRO}-rqt-graph \
    ros-${ROS_DISTRO}-rosbag2-storage-mcap \
    iproute2 \
    vim \
    wget

###--- Install Clang Tool apt packages for development -------------------------###
RUN wget -qO- https://apt.llvm.org/llvm-snapshot.gpg.key | tee /etc/apt/trusted.gpg.d/apt.llvm.org.asc \
    && add-apt-repository "deb http://apt.llvm.org/jammy/ llvm-toolchain-jammy-18 main" \
    && apt-get update \
    && apt-get install -y \
        clang-18 \
        clang-tools-18 \
        clang-18-doc \
        libclang-common-18-dev \
        libclang-18-dev \
        libclang1-18 \
        clang-format-18 \
        python3-clang-18 \
        clangd-18 \
        clang-tidy-18 \
    && rm -rf /var/lib/apt/lists/*

###--- Login with user ---------------------------------------------------------###
USER ${DOCKER_USERNAME}


###################################################################################
###--- tod_vehicle --Deployment-------------------------------------------------###
###################################################################################
FROM tod_vehicle_base AS tod_vehicle

###--- Copy install files from builder -----------------------------------------###
COPY --from=tod_vehicle_builder \
     /home/${DOCKER_USERNAME}/wsp/install /home/${DOCKER_USERNAME}/wsp/install

USER root
RUN mkdir -p /opt/tod-tools
COPY --chmod=0755 work/peanut01_lidar_domain_bridge.py \
                  work/peanut01_can_feedback.py \
                  work/peanut01_control_bridge.py \
                  work/peanut01_control_mapping.py \
                  work/peanut01_control_supervisor.py \
                  work/peanut01_vehicle_state_bridge.py \
                  work/peanut01_vehicle_state_mapping.py \
                  /opt/tod-tools/
USER ${DOCKER_USERNAME}


###################################################################################
###--- tod_operator --Deployment------------------------------------------------###
###################################################################################
FROM tod_operator_base AS tod_operator

###--- Copy install files from builder -----------------------------------------###
COPY --from=tod_operator_builder \
     /home/${DOCKER_USERNAME}/wsp/install /home/${DOCKER_USERNAME}/wsp/install

USER root
RUN mkdir -p /opt/tod-tools
COPY --chmod=0755 work/set_g923_autocenter.py /opt/tod-tools/
COPY work/logitechg923.yaml /opt/tod-tools/logitechg923.yaml
RUN install -m 0644 /opt/tod-tools/logitechg923.yaml \
        /home/${DOCKER_USERNAME}/wsp/install/tod_input_devices/share/tod_input_devices/config/virtual.yaml \
    && install -m 0644 /opt/tod-tools/logitechg923.yaml \
        /home/${DOCKER_USERNAME}/wsp/install/tod_input_devices/share/tod_input_devices/config/logitechg923.yaml \
    && chown -R ${DOCKER_USERNAME}:${DOCKER_USERNAME} /opt/tod-tools \
        /home/${DOCKER_USERNAME}/wsp/install/tod_input_devices/share/tod_input_devices/config
USER ${DOCKER_USERNAME}
